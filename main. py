import asyncio
import json
import os
import time
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, CallbackQueryHandler, ContextTypes

TOKEN = "8772661448:AAGXNERh09PpaQzEQiWCqSy8uSQFD3EZdS0"
FILE = "coins.json"

DAILY_LIMIT = 1000
TAP_VALUE = 1
NAIRA_RATE = 100 # 1000 coins = 100 naira

def load():
    if os.path.exists(FILE):
        with open(FILE, "r") as f:
            return json.load(f)
    return {}

def save(data):
    with open(FILE, "w") as f:
        json.dump(data, f)

db = load()

def get_user(uid):
    uid = str(uid)
    if uid not in db:
        db[uid] = {"coins": 0, "daily": 0, "last_reset": time.time()}
    if time.time() - db[uid]["last_reset"] >= 86400:
        db[uid]["daily"] = 0
        db[uid]["last_reset"] = time.time()
    return db[uid]

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = str(update.effective_user.id)
    get_user(uid)
    save(db)

    keyboard = [
        [InlineKeyboardButton("TAP +1 🌕", callback_data="tap")],
        [InlineKeyboardButton("BALANCE 💰", callback_data="bal")],
        [InlineKeyboardButton("DAILY BONUS 🎁", callback_data="daily")],
        [InlineKeyboardButton("LEADERBOARD 🏆", callback_data="lb")]
    ]

    await update.message.reply_text(
        "🌕 WELCOME TO BUMBER BOT 🌕\n\n"
        "Tap to earn coins and win!\n"
        f"1000 Coins = ₦{NAIRA_RATE}\n"
        f"Daily Limit: {DAILY_LIMIT} coins\n\n"
        "Choose an option below:",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def btn(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    uid = str(q.from_user.id)
    user = get_user(uid)

    if q.data == "tap":
        if user["daily"] >= DAILY_LIMIT:
            await q.answer("⚠️ Daily limit reached! Come back tomorrow", show_alert=True)
            return
        user["coins"] += TAP_VALUE
        user["daily"] += TAP_VALUE
        save(db)
        naira = (user["coins"] / DAILY_LIMIT) * NAIRA_RATE
        await q.edit_message_text(f"✅ +1 BUMBER!\n\nBalance: {user['coins']} 🌕\nToday: {user['daily']}/1000\nEst: ₦{naira:.2f}")

    elif q.data == "bal":
        naira = (user["coins"] / DAILY_LIMIT) * NAIRA_RATE
        await q.edit_message_text(f"💰 YOUR BALANCE\nCoins: {user['coins']} 🌕\nEst Naira: ₦{naira:.2f}\nToday: {user['daily']}/1000")

    elif q.data == "daily":
        if user["daily"] == 0:
            user["coins"] += 100
            save(db)
            await q.edit_message_text("🎁 DAILY BONUS! +100 coins added")
        else:
            await q.edit_message_text("You already collected today. Come back tomorrow!")

    elif q.data == "lb":
        top = sorted(db.items(), key=lambda x: x[1]["coins"], reverse=True)[:10]
        text = "🏆 TOP 10 PLAYERS 🏆\n\n"
        for i, (u, d) in enumerate(top, 1):
            text += f"{i}. {d['coins']} coins\n"
        await q.edit_message_text(text)

app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CallbackQueryHandler(btn))
print("Bot is running - Simple Version...")
app.run_polling()